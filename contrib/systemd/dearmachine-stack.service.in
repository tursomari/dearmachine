[Unit]
Description=DearMachine rootless Podman Compose stack (@RELEASE@)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=@RUNTIME_ENV@
EnvironmentFile=-@STACK_ENV@
ExecStart=@STACK_EXEC@ up
ExecStop=@STACK_EXEC@ down
TimeoutStartSec=900
TimeoutStopSec=180
UMask=0077

[Install]
WantedBy=default.target
